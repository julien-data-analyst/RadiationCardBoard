expression Separation_heure_date =
		// Fonction M pour séparer une colonne datetime en deux colonnes (Date et Time)
		// et supprimer la colonne d'origine
		(col as table, datetimeColumnName as text) as table =>
		let
		    // Ajouter colonne Date avec préfixe
		    AddDate = Table.AddColumn(
		        col,
		        datetimeColumnName & "_DateOnly",
		        each DateTime.Date(Record.Field(_, datetimeColumnName)),
		        type date
		    ),
		    // Ajouter colonne Time avec préfixe
		    AddTime = Table.AddColumn(
		        AddDate,
		        datetimeColumnName & "_TimeOnly",
		        each DateTime.Time(Record.Field(_, datetimeColumnName)),
		        type time
		    ),
		    // Supprimer la colonne d'origine
		    RemoveOriginal = Table.RemoveColumns(AddTime, {datetimeColumnName})
		in
		    RemoveOriginal
	lineageTag: 7ae2d74d-589a-486a-a540-5010cc981b3c
	queryGroup: FCT_M

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression ComparerCols = ```
		/****************************
		Fct : Permet de filtrer la table selon la comparaison d'une colonne commune entre les deux tables sans en faire la jointure.
		Plus optimisé que le List.Contains qui demande beaucoup de mémoire dans le cas de très grandes lignes.
		
		Arguments :
		- TablePrincipale : La table utilisée pour filtrer
		- ColonnePrincipale : La colonne de TablePrincipale à comparer
		- TableARegarder : La table utilisée pour comparer avec la TablePrincipale
		- ColonneARegarder : La colonne de TableARegarder à utiliser
		*****************************/
		(TablePrincipale as table, ColonnePrincipale as text, TableARegarder as table, ColonneARegarder as text) as table =>
		let
		    // Lignes unique sur la colonne à regarder
		    TableARegarderDistinct = Table.Distinct(TableARegarder, {ColonneARegarder}),
		
		    // Effectue la jointure pour filtrer
		    Jointure = Table.NestedJoin(
		        TablePrincipale, {ColonnePrincipale}, 
		        TableARegarderDistinct, {ColonneARegarder}, 
		        "TempJoin", 
		        JoinKind.Inner
		    ),
		    // Supprime la colonne temporaire issue de la jointure
		    Resultat = Table.RemoveColumns(Jointure, {"TempJoin"})
		in
		    Resultat
		```
	lineageTag: 9a709a8c-47ed-4d3c-99a0-2328521114b4
	queryGroup: FCT_M

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

